# Viral Content Agent — API keys (ALL FREE, no credit card).
# Copy this file to  .env  and fill in the keys you have. Everything degrades
# gracefully: with zero keys you still get videos (built-in scripts + color
# backgrounds); each key just makes the output better.
#
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows cmd)

# --- YouTube Data API v3 -----------------------------------------------------
# Powers `research` (what's going viral) AND is the same Google project you use
# for automated upload. Free, no card.
#   1. https://console.cloud.google.com/  ->  create/select a project
#   2. "APIs & Services" -> Library -> enable "YouTube Data API v3"
#   3. "APIs & Services" -> Credentials -> Create credentials -> API key
YOUTUBE_API_KEY=

# --- Pexels (free stock b-roll) ---------------------------------------------
# Vertical video clips behind your captions. Without it: solid-color backgrounds.
#   Sign up free at https://www.pexels.com/api/  and copy your key.
PEXELS_API_KEY=

# --- Google Gemini (free tier) ----------------------------------------------
# Writes original scripts/ideas. Without it: the built-in script bank is used.
#   Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Optional -----------------------------------------------------------------
# Where durable state (SQLite DB, logs, OAuth secrets) is stored. Defaults to
# %LOCALAPPDATA%\ViralContent so it NEVER syncs to OneDrive. Only set this if
# you want a custom location.
# VIRAL_STATE_DIR=
